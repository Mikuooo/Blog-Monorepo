{
  "name": "@blog/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./password": {
      "types": "./src/password.ts",
      "development": "./src/password.ts",
      "production": "./dist/password.js",
      "default": "./dist/password.js"
    },
    "./workload-token": {
      "types": "./src/workload-token.ts",
      "development": "./src/workload-token.ts",
      "production": "./dist/workload-token.js",
      "default": "./dist/workload-token.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude=dist/**",
    "test:coverage": "vitest run --coverage --exclude=dist/**"
  },
  "devDependencies": {
    "@blog/eslint-config": "workspace:*",
    "@blog/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
