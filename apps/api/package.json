{
  "name": "@blog/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @blog/database prisma:generate",
    "dev": "node --import tsx --conditions=development --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude=dist/**",
    "test:integration": "vitest run --config vitest.integration.config.ts test/article-publication.integration.spec.ts test/internal-article-publication.e2e.spec.ts test/auth.e2e.spec.ts test/admin-articles.e2e.spec.ts test/admin-article-commands.e2e.spec.ts",
    "test:coverage": "vitest run --coverage --exclude=dist/**",
    "preopenapi:generate": "pnpm --filter @blog/database prisma:generate",
    "openapi:generate": "node --import tsx --conditions=development src/openapi.ts"
  },
  "dependencies": {
    "@blog/config": "workspace:*",
    "@blog/database": "workspace:*",
    "@blog/event-contracts": "workspace:*",
    "@blog/shared": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@blog/eslint-config": "workspace:*",
    "@blog/typescript-config": "workspace:*",
    "@nestjs/testing": "^11.1.29",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
