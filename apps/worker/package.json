{
  "name": "@blog/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --conditions=development --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude=dist/**",
    "test:coverage": "vitest run --coverage --exclude=dist/**"
  },
  "dependencies": {
    "@blog/config": "workspace:*",
    "@blog/constants": "workspace:*",
    "@blog/event-contracts": "workspace:*",
    "@blog/internal-api-client": "workspace:*",
    "@blog/shared": "workspace:*",
    "bullmq": "^6.0.11",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@blog/eslint-config": "workspace:*",
    "@blog/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
