NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
ADMIN_PORT=3002
ADMIN_API_BASE_URL=http://localhost:3001
WEB_API_BASE_URL=http://localhost:3001
LOG_LEVEL=info
ADMIN_ORIGIN=http://localhost:3002
AUTH_SESSION_COOKIE_NAME=blog_session
AUTH_SESSION_TTL_SECONDS=604800

# S3-compatible object storage. Keep the bucket private and use signed URLs by default.
S3_ENDPOINT=https://<s3-api-endpoint>
S3_REGION=us-east-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
S3_FORCE_PATH_STYLE=false
# Optional CDN/custom public object URL base, without a trailing slash.
S3_PUBLIC_BASE_URL=
S3_UPLOAD_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=900
MEDIA_MAX_UPLOAD_BYTES=26214400

# Runtime connections use the least-privileged role for each environment.
# Development: blog_dev -> blog_dev. Production: blog_app -> blog_prod.
DATABASE_URL=postgresql://blog_dev:<development-password>@<postgres-host>:5432/blog_dev?schema=public
# Prisma migrate/deploy/seed commands use the owner role, never the runtime role.
DATABASE_OWNER_URL=postgresql://blog_owner:<owner-password>@<postgres-host>:5432/blog_dev?schema=public
# Query-only repositories use the read-only role when configured.
DATABASE_READONLY_URL=postgresql://blog_readonly:<readonly-password>@<postgres-host>:5432/blog_dev?schema=public

# The local PostgreSQL profile exists only for isolated *_test databases.
POSTGRES_DB=blog_test
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
TEST_DATABASE_URL=postgresql://blog:blog@localhost:5432/blog_test?schema=public

# Remote Redis ACL connections. Runtime code must select the least-privileged URL.
REDIS_URL=redis://redis_app:<application-password>@<redis-host>:6379
REDIS_WORKER_URL=redis://redis_worker:<worker-password>@<redis-host>:6379
REDIS_ADMIN_URL=redis://redis_admin:<administrator-password>@<redis-host>:6379
REDIS_MONITOR_URL=redis://redis_monitor:<monitor-password>@<redis-host>:6379
REDIS_KEY_PREFIX=blog:dev
BULLMQ_PREFIX=bull:dev
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=3003
OUTBOX_BATCH_SIZE=50
OUTBOX_DISPATCH_INTERVAL_MS=5000
OUTBOX_LEASE_DURATION_MS=30000
OUTBOX_RETRY_DELAY_MS=5000
INTERNAL_API_BASE_URL=http://localhost:3001
INTERNAL_WORKLOAD_ISSUER=blog-worker
INTERNAL_WORKLOAD_AUDIENCE=blog-api-internal
INTERNAL_WORKLOAD_SUBJECT=apps/worker
INTERNAL_WORKLOAD_SECRET=dev-only-change-me-at-least-32-characters

# Optional local administrator provisioning. Leave the password empty to skip it.
SEED_ADMIN_EMAIL=admin@blog.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Local Administrator
SEED_ADMIN_PASSWORD=
