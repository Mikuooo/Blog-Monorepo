NODE_ENV=production

# Production runtime writes use blog_app -> blog_prod.
DATABASE_URL=postgresql://blog_app:<application-password>@<postgres-host>:5432/blog_prod?schema=public
# Migration and seed commands use blog_owner -> blog_prod.
DATABASE_OWNER_URL=postgresql://blog_owner:<owner-password>@<postgres-host>:5432/blog_prod?schema=public
# Query-only repositories use blog_readonly -> blog_prod.
DATABASE_READONLY_URL=postgresql://blog_readonly:<readonly-password>@<postgres-host>:5432/blog_prod?schema=public

# Redis ACL connections. Worker uses REDIS_WORKER_URL; REDIS_ADMIN_URL is operations-only.
REDIS_URL=redis://redis_app:<application-password>@<redis-host>:6379
REDIS_WORKER_URL=redis://redis_worker:<worker-password>@<redis-host>:6379
REDIS_ADMIN_URL=redis://redis_admin:<administrator-password>@<redis-host>:6379
REDIS_MONITOR_URL=redis://redis_monitor:<monitor-password>@<redis-host>:6379
REDIS_KEY_PREFIX=blog:prod
BULLMQ_PREFIX=bull:prod
